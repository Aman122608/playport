 src/dxvk/dxvk_context.h      | 15 +++++++++++
 src/dxvk/dxvk_image.cpp      | 43 +++++++++++++++++++++++++++++
 src/dxvk/dxvk_image.h        | 19 +++++++++++++
 9 files changed, 201 insertions(+), 9 deletions(-)

diff --git a/src/d3d11/d3d11_device.cpp b/src/d3d11/d3d11_device.cpp
index 4d2b666..5198f27 100644
--- a/src/d3d11/d3d11_device.cpp
+++ b/src/d3d11/d3d11_device.cpp
@@ -2766,6 +2766,29 @@ namespace dxvk {
   }
 
 
+  bool D3D11Device::ExportImage(
+    const Rc<DxvkImage>&            Image) {
+    bool feedback = false;
+
+    auto chunk = AllocCsChunk(DxvkCsChunkFlag::SingleUse);
+
+    chunk->push([
+      cImage  = Image,
+      &feedback
+    ] (DxvkContext* ctx) {
+      feedback = ctx->exportImage(cImage, VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT);
+
+      // Submit the copy of the old contents now, so that it lands before
+      // anything another device writes to the memory once it opens it.
+      if (feedback)
+        ctx->flushCommandList(nullptr, nullptr);
+    });
+
+    m_context->InjectCsChunk(DxvkCsQueue::HighPriority, std::move(chunk), true);
+    return feedback;
+  }
+
+
   DxvkShaderOptions D3D11Device::GetShaderOptions(
     const Rc<DxvkDevice>&             Device,
     const D3D11Options&               Options) {
