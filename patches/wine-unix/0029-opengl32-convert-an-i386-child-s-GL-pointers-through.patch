 dlls/opengl32/unix_wgl.c     |   50 +-
 4 files changed, 1846 insertions(+), 1688 deletions(-)

diff --git a/dlls/opengl32/make_opengl b/dlls/opengl32/make_opengl
index 4d45c8ad872..94b48f4c7fa 100755
--- a/dlls/opengl32/make_opengl
+++ b/dlls/opengl32/make_opengl
@@ -325,6 +325,42 @@ my %pointer_is_offset =
      "glGetVertexAttribPointervARB" => "pointer",
     );
 
+# A WoW64 pointer parameter that is an offset into the buffer object bound to
+# a target when there is one, and a client pointer otherwise: the binding to
+# ask the context for at the call.
+sub wow64_buffer_offset_binding($$)
+{
+    my ($name, $pname) = @_;
+    return "GL_ARRAY_BUFFER_BINDING" if $pname eq "pointer" &&
+        $name =~ /^gl(Vertex|Normal|Color|SecondaryColor|Index|EdgeFlag|FogCoord|TexCoord|MultiTexCoord|VertexAttrib|VertexAttribI|VertexAttribL)Pointer(ARB|EXT)?$/;
+    return "GL_ARRAY_BUFFER_BINDING" if $pname eq "pointer" && $name eq "glInterleavedArrays";
+    return "GL_ELEMENT_ARRAY_BUFFER_BINDING" if $pname eq "indices" &&
+        $name =~ /^gl(Multi)?Draw(Range)?Elements(BaseVertex|Instanced|InstancedBaseInstance|InstancedBaseVertex|InstancedBaseVertexBaseInstance)?(ARB|EXT)?$/;
+    return "GL_DRAW_INDIRECT_BUFFER_BINDING" if $pname eq "indirect" &&
+        $name =~ /^gl(Multi)?Draw(Arrays|Elements)Indirect(Count)?(AMD|ARB)?$/;
+    return 0 unless $pname =~ /^(pixels|data|bits|img|bitmap|mask|pattern|table|image|row|column|span|values)$/;
+    return "GL_PIXEL_PACK_BUFFER_BINDING" if $name =~ /^glReadn?Pixels(ARB|KHR)?$/;
+    return "GL_PIXEL_PACK_BUFFER_BINDING" if $name =~ /^glGetn?(Compressed)?(Tex|Texture|MultiTex)(Sub)?Image(ARB|EXT)?$/;
+    return "GL_PIXEL_PACK_BUFFER_BINDING" if
+        $name =~ /^glGetn?(PolygonStipple|ColorTable|ConvolutionFilter|SeparableFilter|Histogram|Minmax|PixelMap(fv|uiv|usv))(ARB|EXT)?$/;
+    return "GL_PIXEL_UNPACK_BUFFER_BINDING" if $name =~ /^gl(Compressed)?(Tex|Texture|MultiTex)(Sub)?Image[123]D(ARB|EXT)?$/;
+    return "GL_PIXEL_UNPACK_BUFFER_BINDING" if
+        $name =~ /^gl(DrawPixels|Bitmap|PolygonStipple|ColorTable|ColorSubTable|ConvolutionFilter[12]D|SeparableFilter2D|PixelMap(fv|uiv|usv))(EXT)?$/;
+    return 0;
+}
+
+# A WoW64 parameter of a pointer type that is not the caller's memory: a GDI
+# handle, a code address, an EGL object, or the user data glDebugMessageCallback
+# hands back to the caller's callback.
+sub wow64_arg_is_value($$$)
+{
+    my ($name, $arg_type, $pname) = @_;
+    return 1 if $arg_type =~ /^(HDC|HENHMETAFILE|GLeglImageOES|GLeglClientBufferEXT)$/;
+    return 1 if $arg_type =~ /PROC/;
+    return 1 if $name =~ /^glDebugMessageCallback/ && $pname eq "userParam";
+    return 0;
+}
+
 sub set_context_attributes($)
 {
     my $name = shift;
@@ -405,6 +441,7 @@ sub generate_unix_thunk($$$$)
     my $need_funcs = !$wrapper || $name !~ /^wgl/;
     my $teb = $is_wow64 ? "teb" : "params->teb";
     my $ret_stat = "return STATUS_SUCCESS;";
+    my $ret_close = "";
     my $input_conv = "";
     my $output_conv = "";
     my $use_pbuffer = 0;
@@ -461,8 +498,12 @@ sub generate_unix_thunk($$$$)
                 {
                     $arg_type =~ s/^const //;
                 }
+                my $binding = wow64_buffer_offset_binding( $name, $pname );
+                my $base = "wow64_window_base()";
+                $base = "0" if $arg_type =~ /(sizei|int)ptr/;
+                $base = "wow64_offset_base( teb, $binding )" if $binding;
                 $vars .= "    $arg_type$pname;\n";
-                $input_conv .= "    $pname = copy_wow64_ptr32s( params->$pname, params->$pointer_array_count{$_} );\n";
+                $input_conv .= "    $pname = copy_wow64_ptr32s( params->$pname, params->$pointer_array_count{$_}, $base );\n";
                 $output_conv .= "    free( $pname );\n";
                 $call_args .= " $pname,";
             }
@@ -470,7 +511,7 @@ sub generate_unix_thunk($$$$)
             {
                 $arg_type =~ s/\*$//;
                 $vars .= "    $arg_type$pname\_arg;\n";
-                $output_conv .= "    *(PTR32 *)UlongToPtr(params->$pname) = PtrToUlong( $pname\_arg );\n";
+                $output_conv .= "    *(PTR32 *)wow64_ptr( params->$pname ) = wow64_ptr32_or_offset( $pname\_arg );\n";
                 $call_args .= " &$pname\_arg,";
             }
             elsif ($arg_type =~ /(sizei|int)ptr/)
@@ -479,15 +520,23 @@ sub generate_unix_thunk($$$$)
             }
             elsif ($arg_type =~ /GLsync/)
             {
-                $call_args .= " get_unix_sync( ULongToPtr(params->$pname) ),";
+                $call_args .= " get_unix_sync( wow64_ptr( params->$pname ) ),";
             }
-            else
+            elsif (my $binding = wow64_buffer_offset_binding( $name, $pname ))
+            {
+                $call_args .= " wow64_ptr_or_offset( teb, $binding, params->$pname ),";
+            }
+            elsif (wow64_arg_is_value( $name, $arg_type, $pname ))
             {
                 $call_args .= " ULongToPtr(params->$pname),";
+            }
+            else
+            {
+                $call_args .= " wow64_ptr( params->$pname ),";
                 $need_manual_thunk = 1 if $arg_type =~ /(\*.*\*|(sizei|int)ptr.*\*)/;
             }
         }
-        $call_args .= " UlongToHandle( params->ret )," if $func_ret =~ /HPBUFFERARB|HGLRC|GLsync/;
+        $call_args .= " wow64_ptr( params->ret )," if $func_ret =~ /HPBUFFERARB|HGLRC|GLsync/;
         if (!is_void_func($func))
         {
             my $ret_type = get_arg_type( $func->[0] );
@@ -499,10 +548,15 @@ sub generate_unix_thunk($$$$)
                 $ret_expr = "ret = ";
                 $ret_stat = "return return_wow64_string( ret, &params->ret );";
             }
-            elsif ($ptype eq "PTR32")
+            elsif ($ptype eq "PTR32" && $func_ret =~ /HDC/)
             {
                 $ret_expr .= "(UINT_PTR)";
-                $need_manual_thunk = 1 if $func_ret !~ /HDC|HPBUFFERARB|HGLRC|GLsync/;
+            }
+            elsif ($ptype eq "PTR32")
+            {
+                $ret_expr .= "wow64_ptr32( ";
+                $ret_close = " )";
+                $need_manual_thunk = 1 if $func_ret !~ /HPBUFFERARB|HGLRC|GLsync/;
             }
         }
         $ret .= "    } *params = args;\n";
@@ -554,7 +608,7 @@ sub generate_unix_thunk($$$$)
     if ($use_dc || $use_pbuffer || $use_context)
     {
         my $param = "params->" . get_arg_name( ${$func->[1]}[0] );
-        $param = "ULongToPtr($param)" if $is_wow64;
+        $param = ($use_dc ? "ULongToPtr($param)" : "wow64_ptr( $param )") if $is_wow64;
         if (!$wrapper)
         {
             $ret .= "    const struct opengl_funcs *funcs = ";
@@ -582,18 +636,18 @@ sub generate_unix_thunk($$$$)
     $ret .= "    $ret_expr";
     if ($wow64_wrap)
     {
-        $ret .= "wow64_$wow64_wrap($call_args funcs->p_$name );\n";
+        $ret .= "wow64_$wow64_wrap($call_args funcs->p_$name )$ret_close;\n";
     }
     elsif ($wrapper)
     {
         $call_args .= " funcs->p_$name," if $name !~ /^wgl/;
         $call_args =~ s/,$/ /;
-        $ret .= "wrap_$wrapper($call_args);\n";
+        $ret .= "wrap_$wrapper($call_args)$ret_close;\n";
     }
     else
     {
         $call_args =~ s/,$/ /;
-        $ret .= "funcs->p_$name($call_args);\n";
+        $ret .= "funcs->p_$name($call_args)$ret_close;\n";
     }
     $ret .= "    set_current_fbo( $teb, params->target, params->framebuffer );\n" if $name =~ /glBindFramebuffer/;
     $ret .= "    pop_default_fbo( $teb );\n" if hide_default_fbo( $name );
diff --git a/dlls/opengl32/unix_private.h b/dlls/opengl32/unix_private.h
index cc5bd442672..ce5dd114063 100644
--- a/dlls/opengl32/unix_private.h
+++ b/dlls/opengl32/unix_private.h
@@ -65,19 +65,91 @@ static inline GLsync get_unix_sync( GLsync sync )
 
 #ifdef _WIN64
 
-static inline void *copy_wow64_ptr32s( UINT_PTR address, ULONG count )
+/* A WoW64 caller's 32-bit pointer is the host address B + the pointer, where B
+ * is 0 on most hosts. On iOS (Playport) every guest process shares this unix
+ * side, and an i386 child's address space is a 4 GiB window at its own host B,
+ * which the calling thread's TEB pair gives: its TEB32's guest address
+ * (Tib.Self) against where the TEB32 is. */
+static inline ULONG_PTR wow64_window_base(void)
 {
-    ULONG *ptrs = (ULONG *)address;
-    void **tmp;
+#ifdef WINE_IOS
+    TEB *teb = NtCurrentTeb();
+    const TEB32 *teb32;
+
+    if (!teb->WowTebOffset) return 0;
+    teb32 = (const TEB32 *)((const char *)teb + teb->WowTebOffset);
+    return (ULONG_PTR)teb32 - teb32->Tib.Self;
+#else
+    return 0;
+#endif
+}
+
+/* the caller's pointer as a host pointer */
+static inline void *wow64_ptr( PTR32 ptr )
+{
+    return ptr ? (void *)(wow64_window_base() + ptr) : NULL;
+}
+
+/* whether a host pointer is one the caller can address */
+static inline BOOL wow64_ptr_fits( const void *ptr )
+{
+    return !(((ULONG_PTR)ptr - wow64_window_base()) >> 32);
+}
+
+extern PTR32 wow64_ptr32_rejected( const void *ptr );
+
+/* a host pointer as the caller's: one it cannot address is reported and NULL */
+static inline PTR32 wow64_ptr32( const void *ptr )
+{
+    if (!ptr) return 0;
+    if (!wow64_ptr_fits( ptr )) return wow64_ptr32_rejected( ptr );
+    return (ULONG_PTR)ptr - wow64_window_base();
+}
+
+/* a pointer GL gives back that is the caller's own client pointer or else an
+ * offset into a buffer object (glGetPointerv, glGetVertexAttribPointerv) */
+static inline PTR32 wow64_ptr32_or_offset( const void *ptr )
+{
+    ULONG_PTR base = wow64_window_base();
+
+    if (base && wow64_ptr_fits( ptr )) return (ULONG_PTR)ptr - base;
+    return PtrToUlong( ptr );
+}
+
+/* what to add to a pointer-or-offset parameter: nothing when a buffer object
+ * is bound to the target of BINDING (the parameter is an offset into it), the
+ * caller's window otherwise (it is a client pointer) */
+static inline ULONG_PTR wow64_offset_base( TEB *teb, GLenum binding )
+{
+    const struct opengl_funcs *funcs = teb->glTable;
+    ULONG_PTR base = wow64_window_base();
+    GLint buffer = 0;
+
+    if (!base || !funcs->p_glGetIntegerv) return base;
+    funcs->p_glGetIntegerv( binding, &buffer );
+    return buffer ? 0 : base;
+}
+
+static inline void *wow64_ptr_or_offset( TEB *teb, GLenum binding, PTR32 ptr )
+{
+    return ptr ? (void *)(wow64_offset_base( teb, binding ) + ptr) : NULL;
+}
+
+/* an array of the caller's 32-bit pointers (BASE: wow64_window_base()), of
+ * pointers or offsets (wow64_offset_base()) or of GLintptr values (0) */
+static inline void *copy_wow64_ptr32s( PTR32 address, ULONG count, ULONG_PTR base )
+{
+    const PTR32 *ptrs = wow64_ptr( address );
+    ULONG_PTR *tmp;
 
     if (!ptrs || !(tmp = calloc( count, sizeof(*tmp) ))) return NULL;
-    while (count--) tmp[count] = ULongToPtr(ptrs[count]);
+    while (count--) tmp[count] = ptrs[count] ? base + ptrs[count] : 0;
     return tmp;
 }
 
 static inline TEB *get_teb64( ULONG teb32 )
 {
-    TEB32 *teb32_ptr = ULongToPtr( teb32 );
+    TEB32 *teb32_ptr = wow64_ptr( teb32 );
     return (TEB *)((char *)teb32_ptr + teb32_ptr->WowTebOffset);
 }
 
