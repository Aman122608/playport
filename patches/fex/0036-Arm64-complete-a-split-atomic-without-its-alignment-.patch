     (void)Bind(&LoopTop);
@@ -262,7 +262,7 @@ DEF_OP(AtomicFetchOr) {
   auto Src = GetReg(Op->Value);
 
   if (CTX->HostFeatures.SupportsAtomics) {
-    ldsetal(SubEmitSize, Src, GetReg(Node), MemSrc);
+    EmitSplitAwareAtomic(MemSrc, IR::OpSizeToSize(IROp->Size), [&] { ldsetal(SubEmitSize, Src, GetReg(Node), MemSrc); });
   } else {
