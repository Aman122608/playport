+#ifdef FEX_IOS_HOST
+/**
+ * @brief Completes a guest split lock that the JIT found before issuing it (PLA-244).
+ *
+ * On an iOS host an atomic that crosses 16 bytes raises an alignment fault whose round trip through
+ * the Mach and Windows exception paths costs tens of microseconds. The JIT checks the address of each
+ * atomic first and, for a split one, calls this through the dispatcher's SplitAtomicHandler stub
+ * instead of issuing it. The access is the same CASAL, CASPAL or atomic memory op the fault would
+ * have reported, completed by the same helpers under the same StrictSplitLockMutex.
+ *
+ * @param GPRs The host registers x0-x30 and sp at the atomic; its result register is written here.
+ * @param ProgramCounter The atomic instruction, which is not executed.
+ */
+void HandleSplitAtomicFromJIT(uint64_t* GPRs, uintptr_t ProgramCounter, FEXCore::Core::CpuStateFrame* Frame);
+#endif
 } // namespace FEXCore::ArchHelpers::Arm64
