diff --git a/FEXCore/Source/Interface/Core/JIT/JITClass.h b/FEXCore/Source/Interface/Core/JIT/JITClass.h
index 7c60a27..02cc273 100644
--- a/FEXCore/Source/Interface/Core/JIT/JITClass.h
+++ b/FEXCore/Source/Interface/Core/JIT/JITClass.h
@@ -246,6 +246,38 @@ private:
     return ConvertSubRegSize8(Op);
   }
 
+  // Emits one LSE atomic instruction (EmitAtomic) on the address in MemSrc, accessing SizeBytes.
+  // PLA-244: on an iOS host an atomic that crosses 16 bytes takes an alignment fault, and its
+  // round trip through the Mach and Windows exception paths costs tens of microseconds. Check
+  // the address first and complete a split one through the dispatcher's SplitAtomicHandler,
+  // under the same lock the fault path takes; neither path changes NZCV.
+  template<typename EmitAtomicFn>
+  void EmitSplitAwareAtomic(ARMEmitter::Register MemSrc, uint32_t SizeBytes, EmitAtomicFn&& EmitAtomic) {
+#ifdef FEX_IOS_HOST
+    if (SizeBytes > 1) {
+      ARMEmitter::ForwardLabel Inside16;
+      ARMEmitter::ForwardLabel Done;
+      // (MemSrc & 15) + SizeBytes > 16 when (MemSrc & 15) - (17 - SizeBytes) is not negative.
+      and_(ARMEmitter::Size::i64Bit, TMP1, MemSrc.X(), 15);
+      sub(ARMEmitter::Size::i64Bit, TMP1, TMP1, 17 - SizeBytes);
+      (void)tbnz(TMP1, 63, &Inside16);
+      ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.SplitAtomicHandler));
+      str<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, -16);
+      blr(TMP1);
+      // SplitAtomicHandler finds the atomic at lr + 8.
+      ldr<ARMEmitter::IndexType::POST>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, 16);
+      (void)b(&Done);
+      (void)Bind(&Inside16);
+      [[maybe_unused]] const auto Before = GetCursorOffset();
+      EmitAtomic();
+      LOGMAN_THROW_A_FMT(GetCursorOffset() - Before == 4, "A split-aware atomic must be one instruction");
+      (void)Bind(&Done);
+      return;
+    }
+#endif
+    EmitAtomic();
+  }
+
   [[nodiscard]]
   static ARMEmitter::VectorRegSizePair ConvertSubRegSizePair16(const IR::IROp_Header* Op) {
     return ARMEmitter::ToVectorSizePair(ConvertSubRegSize16(Op));
diff --git a/FEXCore/Source/Utils/ArchHelpers/Arm64.cpp b/FEXCore/Source/Utils/ArchHelpers/Arm64.cpp
index 3d63fa2..df30768 100644
--- a/FEXCore/Source/Utils/ArchHelpers/Arm64.cpp
+++ b/FEXCore/Source/Utils/ArchHelpers/Arm64.cpp
@@ -2479,4 +2479,30 @@ std::optional<int32_t> HandleUnalignedAccess(FEXCore::Core::InternalThreadState*
 }
 
 
+#ifdef FEX_IOS_HOST
+void HandleSplitAtomicFromJIT(uint64_t* GPRs, uintptr_t ProgramCounter, FEXCore::Core::CpuStateFrame* Frame) {
+  const uint32_t Instr = *reinterpret_cast<const uint32_t*>(ProgramCounter);
+  auto CTX = static_cast<Context::ContextImpl*>(Frame->Thread->CTX);
+  uint32_t* StrictSplitLockMutex {CTX->Config.StrictInProcessSplitLocks ? &CTX->StrictSplitLockMutex : nullptr};
+
+  bool Handled = false;
+  if ((Instr & CASPAL_MASK) == CASPAL_INST) {
+    Handled = HandleCASPAL(Instr, GPRs, StrictSplitLockMutex);
+  } else if ((Instr & CASAL_MASK) == CASAL_INST) {
+    Handled = HandleCASAL(GPRs, Instr, StrictSplitLockMutex);
+  } else if ((Instr & ATOMIC_MEM_MASK) == ATOMIC_MEM_INST) {
+    Handled = HandleAtomicMemOp(Instr, GPRs, StrictSplitLockMutex);
+  }
+
+  /* PLA-244: counted; the first 8 and every 65536th are logged, with the count. */
+  static uint64_t SplitLocks;
+  const uint64_t N = __atomic_add_fetch(&SplitLocks, 1, __ATOMIC_RELAXED);
+  if (!Handled) {
+    LogMan::Msg::EFmt("Unhandled JIT split lock: PC: 0x{:x} Instruction: 0x{:08x}", ProgramCounter, Instr);
+  } else if (N <= 8 || (N % 65536) == 0) {
+    LogMan::Msg::DFmt("JIT split lock #{} (the first 8 and every 65536th are logged): pc: {:X}", N, ProgramCounter);
+  }
+}
+#endif
+
 } // namespace FEXCore::ArchHelpers::Arm64
