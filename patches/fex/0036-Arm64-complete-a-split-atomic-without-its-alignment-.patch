+    EmitSplitAwareAtomic(MemSrc, IR::OpSizeToSize(IROp->Size), [&] { ldeoral(SubEmitSize, Src, GetReg(Node), MemSrc); });
   } else {
     ARMEmitter::BackwardLabel LoopTop;
     (void)Bind(&LoopTop);
@@ -309,7 +309,7 @@ DEF_OP(AtomicFetchNeg) {
