+#ifdef FEX_IOS_HOST
+// PLA-244: the out-of-line half of a split atomic (Arm64JITCore::EmitSplitAwareAtomic).
+//
+// Entered by `blr` with the caller's lr pushed at [sp] and lr pointing two instructions before the
+// atomic it did not issue. Saves x0-x30, sp, q0-q31 and NZCV, so every register the JIT holds,
+// static or dynamic, survives the C call; the saved x0-x31 are the GPR array the unaligned-access
+// helpers decode the atomic's registers against, and the atomic's result is written back into it.
+void Dispatcher::EmitSplitAtomicHandler() {
+  SplitAtomicHandlerAddress = GetCursorAddress<uint64_t>();
+
+  // NZCV and lr first, then x0-x31, then q0-q31: every offset in range of its stp/ldp.
+  constexpr uint32_t MiscOffset = 0;
+  constexpr uint32_t GPROffset = 16;
+  constexpr uint32_t FPROffset = GPROffset + 32 * 8;
+  constexpr uint32_t FrameSize = FPROffset + 32 * 16;
+  static_assert(FrameSize % 16 == 0 && FPROffset % 16 == 0);
+
+  ARMEmitter::ForwardLabel l_Handler;
+
+  sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+  for (uint32_t i = 0; i < 30; i += 2) {
+    stp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::XRegister(i), ARMEmitter::XRegister(i + 1), ARMEmitter::Reg::rsp, GPROffset + i * 8);
+  }
+  // x30 is the caller's, pushed before its blr; slot 31 holds the caller's sp.
+  ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, FrameSize);
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, ARMEmitter::Reg::rsp, FrameSize + 16);
+  stp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::XReg::x0, ARMEmitter::XReg::x1, ARMEmitter::Reg::rsp, GPROffset + 30 * 8);
+  for (uint32_t i = 0; i < 32; i += 2) {
+    stp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::QRegister(i), ARMEmitter::QRegister(i + 1), ARMEmitter::Reg::rsp, FPROffset + i * 16);
+  }
+  mrs(ARMEmitter::XReg::x0, ARMEmitter::SystemRegister::NZCV);
+  stp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::XReg::x0, ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, MiscOffset);
+
+  // HandleSplitAtomicFromJIT(GPRs, the atomic's pc, Frame)
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r0, ARMEmitter::Reg::rsp, GPROffset);
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, ARMEmitter::Reg::r30, 8);
+  mov(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r2, STATE);
+  ldr(ARMEmitter::XReg::x3, &l_Handler);
+  if (!CTX->Config.DisableVixlIndirectCalls) [[unlikely]] {
+    GenerateIndirectRuntimeCall<void, uint64_t, uint64_t, uint64_t>(ARMEmitter::Reg::r3);
+  } else {
+    blr(ARMEmitter::Reg::r3);
+  }
+
+  ldp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::XReg::x0, ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, MiscOffset);
+  msr(ARMEmitter::SystemRegister::NZCV, ARMEmitter::XReg::x0);
+  for (uint32_t i = 0; i < 32; i += 2) {
+    ldp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::QRegister(i), ARMEmitter::QRegister(i + 1), ARMEmitter::Reg::rsp, FPROffset + i * 16);
+  }
+  // The atomic's result may be x30: hand it back through the caller's slot.
+  ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, GPROffset + 30 * 8);
+  str(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, FrameSize);
+  for (uint32_t i = 0; i < 30; i += 2) {
+    ldp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::XRegister(i), ARMEmitter::XRegister(i + 1), ARMEmitter::Reg::rsp, GPROffset + i * 8);
+  }
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+  ret();
+
+  Align(8);
+  (void)Bind(&l_Handler);
+  dc64(reinterpret_cast<uint64_t>(&FEXCore::ArchHelpers::Arm64::HandleSplitAtomicFromJIT));
+}
+#endif
+
