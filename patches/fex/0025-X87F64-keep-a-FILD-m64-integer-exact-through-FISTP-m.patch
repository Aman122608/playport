From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Mon, 12 Oct 2026 03:27:59 +0200
Subject: [PATCH] X87F64: keep a FILD m64 integer exact through FISTP m64

With X87ReducedPrecision the x87 stack holds doubles, which keep 53 bits.
32-bit MSVC loads a 64-bit value atomically with `fild qword [m]; fistp
qword [m2]`, and a lock-free list keeps a {pointer, tag} pair this way: a
tag with its top bit set puts the pair near 2^63, so the double keeps the
pointer only to 1 KiB and the game reads freed or uncommitted memory.

FILD m64 now pushes with PushStackFromInt64, and the x87 stack pass keeps
the loaded integer beside the stack value while that value is unchanged
(FXCH, FLD ST(i) and FST ST(i) move it; any arithmetic replaces it). FIST
and FISTTP m64 read ReadStackInt64, which the pass resolves to that integer,
or to the converted double when the top was changed or the pass is on its
slow path. An integer-valued x87 value converts exactly under any rounding
mode, so this is what 80-bit x87 stores. Without a FIST m64 the integer copy
is dead and removed, so FILD alone compiles as before.

Class: upstream-bug
Evidence: docs/evidence/2026-10-12-x87-fild-fistp-m64.md
Offered-upstream: no
---
 .../Core/OpcodeDispatcher/X87F64.cpp          | 10 +++-
 FEXCore/Source/Interface/IR/IR.json           | 17 +++++++
 .../IR/Passes/x87StackOptimizationPass.cpp    | 35 ++++++++++++++
 .../ASM/X87_F64/FILD_FISTP_I64_Exact_F64.asm  | 47 +++++++++++++++++++
 4 files changed, 108 insertions(+), 1 deletion(-)
 create mode 100644 unittests/ASM/X87_F64/FILD_FISTP_I64_Exact_F64.asm

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87F64.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87F64.cpp
index 362a139..560db77 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87F64.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87F64.cpp
@@ -99,7 +99,13 @@ void OpDispatchBuilder::FILDF64(OpcodeArgs) {
     Data = _Sbfe(OpSize::i64Bit, IR::OpSizeAsBits(ReadWidth), 0, Data);
   }
   auto ConvertedData = _Float_FromGPR_S(OpSize::i64Bit, ReadWidth == OpSize::i32Bit ? OpSize::i32Bit : OpSize::i64Bit, Data);
-  _PushStack(ConvertedData, Invalid(), OpSize::iInvalid);
+  if (ReadWidth == OpSize::i64Bit) {
+    // A double holds only 53 bits: keep the integer, so that a FISTP m64 of the unchanged value
+    // stores it exactly, as 32-bit MSVC's atomic 64-bit load (fild m64; fistp m64) needs.
+    _PushStackFromInt64(ConvertedData, _VCastFromGPR(OpSize::i64Bit, OpSize::i64Bit, Data));
+  } else {
+    _PushStack(ConvertedData, Invalid(), OpSize::iInvalid);
+  }
 }
 
 void OpDispatchBuilder::FISTF64(OpcodeArgs, bool Truncate) {
@@ -114,6 +120,8 @@ void OpDispatchBuilder::FISTF64(OpcodeArgs, bool Truncate) {
     } else {
       data = _Vector_FToS(OpSize::i128Bit, OpSize::i64Bit, data);
     }
+    // The integer of an unchanged FILD m64, which the conversion would round.
+    data = _ReadStackInt64(data);
     StoreResultFPR_WithOpSize(Op, Op->Dest, data, OpSize::i64Bit, OpSize::i8Bit);
   } else {
     if (Truncate) {
diff --git a/FEXCore/Source/Interface/IR/IR.json b/FEXCore/Source/Interface/IR/IR.json
index 172d62d..edb1aaf 100644
--- a/FEXCore/Source/Interface/IR/IR.json
+++ b/FEXCore/Source/Interface/IR/IR.json
@@ -2969,6 +2969,14 @@
         "HasSideEffects": true,
         "X87": true
       },
+      "PushStackFromInt64 FPR:$X80Src, FPR:$Int64Value": {
+        "Desc": [
+          "Reduced precision only: pushes X80Src, the 64-bit float converted from the 64-bit integer Int64Value, on to the x87 stack.",
+          "Tracks Int64Value so that ReadStackInt64 returns it exactly while the value is unchanged on the stack."
+        ],
+        "HasSideEffects": true,
+        "X87": true
+      },
       "CopyPushStack u8:$StackLocation": {
         "Desc": [
           "Pushes an element already on the stack onto the top."
@@ -3009,6 +3017,15 @@
         "DestSize": "OpSize::i128Bit",
         "X87": true
       },
+      "FPR = ReadStackInt64 FPR:$Converted": {
+        "Desc": [
+          "Reduced precision only: the 64-bit integer for a FIST of the top of the stack.",
+          "If the top was pushed by PushStackFromInt64 and is unchanged, its Int64Value, which a 64-bit float may not hold exactly;",
+          "otherwise Converted, the top converted to a 64-bit integer."
+        ],
+        "DestSize": "OpSize::i64Bit",
+        "X87": true
+      },
       "GPR = StackValidTag u8:$StackLocation": {
         "Desc": [
           "Returns 1 if the value in location TOP+$StackLocation is valid, 0 otherwise."
diff --git a/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp b/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
index 8b54ea1..36bda96 100644
--- a/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
+++ b/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
@@ -309,6 +309,10 @@ private:
     // Tuple is only valid if we have information about the Source of the Stack Data Node.
     // In it's valid then OpSize is the original source size and Ref is the original source node.
     std::optional<StackMemberData> Source {};
+
+    // Reduced precision: the 64-bit integer (in an FPR) that a FILD m64 converted to StackDataNode,
+    // which a double may not hold exactly. Null unless pushed by PushStackFromInt64.
+    Ref Int64Source {};
   };
 
   // StackData, TopCache need to be always properly set to ensure
@@ -956,6 +960,21 @@ void X87StackOptimization::Run(IREmitter* Emit) {
         break;
       }
 
+      case OP_PUSHSTACKFROMINT64: {
+        const auto* Op = IROp->C<IROp_PushStackFromInt64>();
+        auto* SourceNode = CurrentIR.GetNode(Op->X80Src);
+
+        if (SlowPath) {
+          UpdateTopForPush_Slow();
+          StoreStackValueAtOffset_Slow(SourceNode);
+        } else {
+          StackMemberInfo Member {SourceNode};
+          Member.Int64Source = CurrentIR.GetNode(Op->Int64Value);
+          StackData.push(Member);
+        }
+        break;
+      }
+
       case OP_COPYPUSHSTACK: {
         const auto* Op = IROp->C<IROp_CopyPushStack>();
         auto Offset = Op->StackLocation;
@@ -980,6 +999,22 @@ void X87StackOptimization::Run(IREmitter* Emit) {
         break;
       }
 
+      case OP_READSTACKINT64: {
+        // FIST m64 of the top. While the top is the unchanged value of a FILD m64 (moved only by
+        // FXCH, FLD ST(i) or FST ST(i)), store the loaded integer rather than the rounded double.
+        const auto* Op = IROp->C<IROp_ReadStackInt64>();
+        Ref Result = CurrentIR.GetNode(Op->Converted);
+        if (!SlowPath) {
+          const auto& [Valid, StackMember] = StackData.top(0);
+          if (Valid == StackSlot::VALID && StackMember.Int64Source) {
+            Result = StackMember.Int64Source;
+          }
+        }
+
+        IREmit->ReplaceUsesWithAfter(CodeNode, Result, CodeNode);
+        break;
+      }
+
       case OP_STACKVALIDTAG: {
         // Returns 0 if value is valid and 1 otherwise.
         const auto* Op = IROp->C<IROp_StackValidTag>();
diff --git a/unittests/ASM/X87_F64/FILD_FISTP_I64_Exact_F64.asm b/unittests/ASM/X87_F64/FILD_FISTP_I64_Exact_F64.asm
new file mode 100644
index 0000000..0a4713a
--- /dev/null
+++ b/unittests/ASM/X87_F64/FILD_FISTP_I64_Exact_F64.asm
@@ -0,0 +1,47 @@
+%ifdef CONFIG
+{
+  "RegData": {
+    "RAX": "0x84280002320300a8",
+    "RBX": "0x84280002320300a8",
+    "RCX": "0x84280002320300a8",
+    "RSI": "0x8428000232030000"
+  },
+  "Env": { "FEX_X87REDUCEDPRECISION" : "1" }
+}
+%endif
+
+; 32-bit MSVC loads a 64-bit value atomically with fild m64; fistp m64.
+; A double holds 53 bits, so the unchanged value must come back exactly.
+mov rdx, 0xe0000000
+
+mov rax, 0x84280002320300a8
+mov [rdx + 8 * 0], rax
+
+; fild then fistp
+fild qword [rdx + 8 * 0]
+fistp qword [rdx + 8 * 1]
+mov rax, [rdx + 8 * 1]
+
+; fild, moved by fxch, then fisttp
+fild qword [rdx + 8 * 0]
+fld1
+fxch
+fisttp qword [rdx + 8 * 2]
+fstp st0
+mov rbx, [rdx + 8 * 2]
+
+; fild, copied by fld st0, then fistp of the copy
+fild qword [rdx + 8 * 0]
+fld st0
+fistp qword [rdx + 8 * 3]
+fstp st0
+mov rcx, [rdx + 8 * 3]
+
+; A changed value goes through the double: fild, +0, fistp rounds.
+fild qword [rdx + 8 * 0]
+fldz
+faddp
+fistp qword [rdx + 8 * 4]
+mov rsi, [rdx + 8 * 4]
+
+hlt
