 }
 
+#ifdef FEX_IOS_HOST
+/* PLA-206: the trap (ProtectRWXIntervalsInternal) makes the RWX pages of a host page
+ * read-only, but Wine gives the host page the union of its four guest pages'
+ * protections. A committed writable page in it that is not RWX (a data page of the
+ * same allocation or image) keeps the host page writable, so a write to the code
+ * beside it never faults and the old translation runs. Such a host page is not
+ * trapped: its blocks check their own bytes (FullSMC). */
+bool InvalidationTracker::HostPageHasUntrappableWritablePage(uint64_t HostPage) {
+  for (uint64_t Page = HostPage; Page < HostPage + TrapGranuleSize; Page += FEXCore::Utils::FEX_PAGE_SIZE) {
+    if (RWXIntervals.Query(Page).Enclosed) {
+      continue;
+    }
+    MEMORY_BASIC_INFORMATION Info;
+    if (NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Page), MemoryBasicInformation, &Info, sizeof(Info), nullptr)) {
+      continue;
+    }
+    if (Info.State == MEM_COMMIT && ProtIsWritable(Info.Protect)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/* The RWX range [Base, End) holding Address, split at the host pages a write may not
+ * trap: only a host page the range covers in part can hold a page that is not RWX, so
+ * a range aligned to host pages costs nothing. Address in such a host page gets that
+ * host page's part of the range with FullSMC; elsewhere the range without them, so
+ * the decoder asks again at their boundary. With SMC detection off (Mono) nothing is
+ * checked, as upstream. Called with IntervalsLock held. */
+FEXCore::HLE::ExecutableRangeInfo InvalidationTracker::QueryRWXRangeByHostPage(uint64_t Address, uint64_t Base, uint64_t End) {
+  const uint64_t FirstPage = Base & TrapGranuleMask;
+  const uint64_t LastPage = (End - 1) & TrapGranuleMask;
+  if (!HostPageCodeChecks || SMCDetectionDisabled || (Base == FirstPage && End == LastPage + TrapGranuleSize)) {
+    return {Base, End - Base, true};
+  }
+  const bool FirstPartial = Base != FirstPage || (LastPage == FirstPage && End != LastPage + TrapGranuleSize);
+  const bool LastPartial = LastPage != FirstPage && End != LastPage + TrapGranuleSize;
+  const bool FirstUntrappable = FirstPartial && HostPageHasUntrappableWritablePage(FirstPage);
+  const bool LastUntrappable = LastPartial && HostPageHasUntrappableWritablePage(LastPage);
+  const uint64_t Page = Address & TrapGranuleMask;
+  if ((Page == FirstPage && FirstUntrappable) || (Page == LastPage && LastUntrappable)) {
+    const uint64_t RangeBase = std::max(Base, Page);
+    const uint64_t RangeEnd = std::min(End, Page + TrapGranuleSize);
+    static std::atomic<uint32_t> FullSMCCount;
+    const auto N = FullSMCCount.fetch_add(1) + 1;
+    if (N <= 8 || !(N % 4096)) {
+      LogMan::Msg::EFmt("[smc-hostpage] #{} {:#x}-{:#x}: a writable page shares the host page, blocks check their code (PLA-206)", N,
+                        RangeBase, RangeEnd);
+    }
+    return {RangeBase, RangeEnd - RangeBase, true, true};
+  }
+  const uint64_t RangeBase = FirstUntrappable ? FirstPage + TrapGranuleSize : Base;
+  const uint64_t RangeEnd = LastUntrappable ? LastPage : End;
+  return {RangeBase, RangeEnd - RangeBase, true};
+}
+#endif
+
