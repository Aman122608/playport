+  // (QueryRWXRangeByHostPage). Only the WOW64 module: in an x86-64 process Wine's
+  // write-strip heal, not the union, makes such a host page writable, and a block that
+  // checks its code there deadlocked on its first mismatch.
+  void EnableHostPageCodeChecks() {
+    HostPageCodeChecks = true;
+  }
+#endif
