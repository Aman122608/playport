From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Sun, 11 Oct 2026 23:35:55 +0200
Subject: [PATCH] kk: keep workaround 6 for descriptor loads outside fragment
 shaders on iOS 27

KosmicKrisp turns workaround 6 (every device memory access coherent)
off when the system is at least version 27, since macOS 27 fixed the
Metal coherency bug behind it. The version check holds on iOS 27 too,
where loads of descriptor sets still need it: on an A19 Pro, Cat Mail
Co. Demo's Unity 6 URP scene, drawn through indirect draws, lost most
of its objects, drew the rest rotated and in other objects' places and
left a blown-out void.

With MESA_KK_DEBUG=os26_workarounds only the plays with workaround 6
off drew the scene wrong. Of workaround 6 in every stage but fragment
shaders, the scene stayed right without it on buffer loads and stores
and without it on uniform buffer loads, and went wrong again without it
on descriptor set loads; it was right with it in vertex shaders alone,
and wrong with it in compute shaders alone or only in shaders that
write memory. Coherent descriptor loads in fragment shaders too halved
Portal 2's frame rate. So on iOS descriptor set loads stay coherent in
every stage but fragment shaders, unless MESA_KK_DISABLE_WORKAROUNDS
names 6; the pipeline cache key includes the choice.

Class: ios-port
Evidence: docs/evidence/2026-10-11-kk-ios27-workarounds.md
Offered-upstream: no
---
 docs/drivers/kosmickrisp/workarounds.rst    |  1 +
 src/kosmickrisp/compiler/msl_private.h      |  1 +
 src/kosmickrisp/compiler/nir_to_msl.c       |  3 +++
 src/kosmickrisp/compiler/nir_to_msl.h       |  4 ++++
 src/kosmickrisp/vulkan/kk_physical_device.c | 13 +++++++++++++
 src/kosmickrisp/vulkan/kk_physical_device.h |  4 ++++
 src/kosmickrisp/vulkan/kk_shader.c          |  3 +++
 7 files changed, 29 insertions(+)

diff --git a/docs/drivers/kosmickrisp/workarounds.rst b/docs/drivers/kosmickrisp/workarounds.rst
index a7f16fa..7ba535e 100644
--- a/docs/drivers/kosmickrisp/workarounds.rst
+++ b/docs/drivers/kosmickrisp/workarounds.rst
@@ -318,6 +318,7 @@ Hopefully this does not affect performance much.
 | Log:
 | 2025-12-08: Workaround implemented and reported to Apple
 | 2026-06-22: Fixed in macOS 27 Beta (Build 26A5353q)
+| 2026-10-11: Still needed on iOS 27.0 (A19 Pro) for descriptor set loads; kept on there for those outside fragment shaders
 
 KK_WORKAROUND_5
 ---------------
diff --git a/src/kosmickrisp/compiler/msl_private.h b/src/kosmickrisp/compiler/msl_private.h
index 75da653..ea349b4 100644
--- a/src/kosmickrisp/compiler/msl_private.h
+++ b/src/kosmickrisp/compiler/msl_private.h
@@ -24,6 +24,7 @@ struct nir_to_msl_ctx {
    nir_shader *shader;
    struct _mesa_string_buffer *text;
    uint64_t disabled_workarounds;
+   bool coherent_descriptor_loads;
    bool uses_per_draw_data;
    unsigned short indentlevel;
    struct io_slot_info inputs_info[NUM_TOTAL_VARYING_SLOTS];
diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index 63d2ec1..b6dc942 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -1370,6 +1370,8 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
       enum gl_access_qualifier access = nir_intrinsic_access(instr);
       const char *type = msl_type_for_def(ctx->types, &instr->def);
       const char *qualifier = global_access_qualifier(ctx, access);
+      if (ctx->coherent_descriptor_loads && (access & ACCESS_CAN_SPECULATE))
+         qualifier = "coherent device";
       if (access & ACCESS_ATOMIC) {
          assert(instr->num_components == 1u &&
                 "We can only do single component with atomics");
@@ -2499,6 +2501,7 @@ nir_to_msl(nir_shader *shader, struct nir_to_msl_options *options)
       .shader = shader,
       .text = _mesa_string_buffer_create(options->mem_ctx, 1024),
       .disabled_workarounds = options->disabled_workarounds,
+      .coherent_descriptor_loads = options->coherent_descriptor_loads,
    };
    nir_function_impl *impl = nir_shader_get_entrypoint(shader);
    msl_gather_info(&ctx, options);
diff --git a/src/kosmickrisp/compiler/nir_to_msl.h b/src/kosmickrisp/compiler/nir_to_msl.h
index 423df8a..c4f5cf6 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.h
+++ b/src/kosmickrisp/compiler/nir_to_msl.h
@@ -17,6 +17,10 @@ struct vk_color_attachment_location_state;
 struct nir_to_msl_options {
    void *mem_ctx;
    uint64_t disabled_workarounds;
+   /* Descriptor set loads (load_global_constant_offset marked
+    * ACCESS_CAN_SPECULATE) are coherent device loads, as KK_WORKAROUND_6 makes
+    * them, whatever disabled_workarounds says */
+   bool coherent_descriptor_loads;
 
    /* Required to correctly declare fragment outputs. Shader may contain
     * shrinked writes which can lead to writting less components than the ones
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 4a27f1d..27d4ef6 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -1007,6 +1007,8 @@ kk_physical_device_init_pipeline_cache(struct kk_physical_device *pdev)
                        sizeof(pdev->info.msl_version));
    _mesa_blake3_update(&blake3_ctx, &pdev->settings.disabled_workarounds,
                        sizeof(pdev->settings.disabled_workarounds));
+   _mesa_blake3_update(&blake3_ctx, &pdev->settings.descriptor_workaround_6,
+                       sizeof(pdev->settings.descriptor_workaround_6));
    const uint64_t compiler_flags =
       kk_mesa_debug_flags & KK_DEBUG_FORCE_ROBUSTNESS;
    _mesa_blake3_update(&blake3_ctx, &compiler_flags, sizeof(compiler_flags));
@@ -1153,6 +1155,17 @@ kk_parse_environment_options(struct kk_physical_device *pdev)
 
    /* Workarounds resolved on macOS 27 */
    if (ns_is_os_version_at_least(27, 0, 0) && !KK_DEBUG(OS26_WORKAROUNDS)) {
+#if DETECT_OS_APPLE && TARGET_OS_IPHONE
+      /* Not workaround 6 for descriptor set loads outside fragment shaders on
+       * iOS 27 (A19 Pro): without coherent descriptor loads in its vertex
+       * shaders, a Unity 6 scene drawn through indirect draws loses most of
+       * its objects and draws the rest from other objects' data. Coherent
+       * buffer loads and stores are not needed for it; coherent descriptor
+       * loads in fragment shaders cost a GPU-bound DXVK title over twice its
+       * GPU time, so not those. */
+      settings->descriptor_workaround_6 =
+         !(settings->disabled_workarounds & BITFIELD64_BIT(6));
+#endif
       /* 1-6 */
       settings->disabled_workarounds |= BITFIELD64_MASK(7);
 
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.h b/src/kosmickrisp/vulkan/kk_physical_device.h
index bc83782..2482f94 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.h
+++ b/src/kosmickrisp/vulkan/kk_physical_device.h
@@ -56,6 +56,10 @@ struct kk_env_settings {
     * not the device's whole life; 0 for the whole life. */
    uint32_t gpu_capture_frame;
    uint64_t disabled_workarounds;
+   /* KK_WORKAROUND_6 for descriptor set loads in every stage but fragment
+    * shaders, whatever disabled_workarounds says: iOS 27 still needs it
+    * there */
+   bool descriptor_workaround_6;
 };
 
 struct kk_physical_device {
diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index bbb90e5..7b72cf3 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -1342,6 +1342,9 @@ kk_compile_shader(struct kk_device *dev, nir_shader *nir,
    struct nir_to_msl_options translate_options = {
       .mem_ctx = NULL,
       .disabled_workarounds = pdev->settings.disabled_workarounds,
+      .coherent_descriptor_loads =
+         nir->info.stage != MESA_SHADER_FRAGMENT &&
+         pdev->settings.descriptor_workaround_6,
    };
    if (nir->info.stage == MESA_SHADER_FRAGMENT) {
       for (uint32_t i = 0u; i < MAX_DRAW_BUFFERS; ++i) {
