+#ifdef __APPLE__
+/* On Apple systems a surfaceless display with Zink also has window surfaces:
+ * the native window is a CAMetalLayer, which kopper presents to through a
+ * VK_EXT_metal_surface swap chain. Pbuffers stay as they are.
+ */
+static EGLBoolean
+dri2_surfaceless_kopper_swap_interval(_EGLDisplay *disp, _EGLSurface *surf,
+                                      EGLint interval)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   if (surf->Type == EGL_WINDOW_BIT)
+      kopperSetSwapInterval(dri2_surf->dri_drawable, interval);
+   return EGL_TRUE;
+}
+
+static _EGLSurface *
+dri2_surfaceless_kopper_create_window_surface(_EGLDisplay *disp,
+                                              _EGLConfig *conf,
+                                              void *native_window,
+                                              const EGLint *attrib_list)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   _EGLSurface *surf = dri2_surfaceless_create_surface(
+      disp, EGL_WINDOW_BIT, conf, attrib_list, native_window);
+
+   if (surf)
+      dri2_surfaceless_kopper_swap_interval(disp, surf,
+                                            dri2_dpy->default_swap_interval);
+   return surf;
+}
+
+static EGLBoolean
+dri2_surfaceless_kopper_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+
+   if (draw->Type != EGL_WINDOW_BIT)
+      return EGL_TRUE;
+
+   kopperSwapBuffers(dri2_surf->dri_drawable,
+                     __DRI2_FLUSH_CONTEXT | __DRI2_FLUSH_INVALIDATE_ANCILLARY);
+   /* kopper re-creates the swap chain when the layer's size changes. */
+   kopperQuerySurfaceSize(dri2_surf->dri_drawable, &draw->Width, &draw->Height);
+   return EGL_TRUE;
+}
+
+static EGLint
+dri2_surfaceless_kopper_query_buffer_age(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   return kopperQueryBufferAge(dri2_surf->dri_drawable);
+}
+
+static const struct dri2_egl_display_vtbl dri2_surfaceless_kopper_display_vtbl = {
+   .create_window_surface = dri2_surfaceless_kopper_create_window_surface,
+   .create_pbuffer_surface = dri2_surfaceless_create_pbuffer_surface,
+   .destroy_surface = surfaceless_destroy_surface,
+   .create_image = dri2_create_image_khr,
+   .swap_interval = dri2_surfaceless_kopper_swap_interval,
+   .swap_buffers = dri2_surfaceless_kopper_swap_buffers,
+   .query_buffer_age = dri2_surfaceless_kopper_query_buffer_age,
+   .get_dri_drawable = dri2_surface_get_dri_drawable,
+};
+
+static_assert(sizeof(struct kopper_vk_surface_create_storage) >=
+                 sizeof(VkMetalSurfaceCreateInfoEXT),
+              "");
+
+static void
+surfaceless_kopper_set_surface_create_info(void *draw,
+                                           struct kopper_loader_info *out)
+{
+   struct dri2_egl_surface *dri2_surf = draw;
+   VkMetalSurfaceCreateInfoEXT *metal = (VkMetalSurfaceCreateInfoEXT *)&out->bos;
+
+   if (dri2_surf->base.Type != EGL_WINDOW_BIT)
+      return;
+
+   metal->sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT;
+   metal->pNext = NULL;
+   metal->flags = 0;
+   metal->pLayer = dri2_surf->base.NativeSurface;
+   /* The layer shows what is presented; an alpha below one would let what is
+    * behind it through. */
+   out->present_opaque = true;
+}
+
+static void
+surfaceless_kopper_get_drawable_info(struct dri_drawable *draw, int *w, int *h,
+                                     void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+   if (dri2_surf->base.Type == EGL_WINDOW_BIT) {
+      dri2_surfaceless_metal_layer_size(dri2_surf->base.NativeSurface, w, h);
+   } else {
+      *w = dri2_surf->base.Width;
+      *h = dri2_surf->base.Height;
+   }
+}
+
+static const __DRIkopperLoaderExtension surfaceless_kopper_loader_extension = {
+   .base = {__DRI_KOPPER_LOADER, 1},
+   .SetSurfaceCreateInfo = surfaceless_kopper_set_surface_create_info,
+   .GetDrawableInfo = surfaceless_kopper_get_drawable_info,
+};
+#endif
+
 static void
 surfaceless_flush_front_buffer(struct dri_drawable *driDrawable, void *loaderPrivate)
 {
@@ -216,8 +338,12 @@ static const __DRIextension *swrast_loader_extensions[] = {
 };
 
