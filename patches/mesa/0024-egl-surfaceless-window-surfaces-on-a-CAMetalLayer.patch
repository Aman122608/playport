-   &kopper_pbuffer_loader_extension.base, &image_lookup_extension.base,
-   &image_lookup_extension.base, NULL,
+#ifdef __APPLE__
+   &surfaceless_kopper_loader_extension.base,
+#else
+   &kopper_pbuffer_loader_extension.base,
+#endif
+   &image_lookup_extension.base, &image_lookup_extension.base, NULL,
 };
 
 static bool
@@ -406,7 +532,15 @@ dri2_initialize_surfaceless(_EGLDisplay *disp)
 #endif
    dri2_set_WL_bind_wayland_display(disp);
 
-   dri2_add_pbuffer_configs_for_visuals(disp);
+#ifdef __APPLE__
+   if (dri2_dpy->kopper) {
+      dri2_setup_swap_interval(disp, 1);
+      dri2_add_pbuffer_configs_for_visuals(disp, EGL_PBUFFER_BIT | EGL_WINDOW_BIT);
+      dri2_dpy->vtbl = &dri2_surfaceless_kopper_display_vtbl;
+      return EGL_TRUE;
+   }
+#endif
+   dri2_add_pbuffer_configs_for_visuals(disp, EGL_PBUFFER_BIT);
 
    /* Fill vtbl last to prevent accidentally calling virtual function during
     * initialization.
diff --git a/src/egl/drivers/dri2/platform_surfaceless_metal.h b/src/egl/drivers/dri2/platform_surfaceless_metal.h
new file mode 100644
index 0000000..6bbe5cb
--- /dev/null
+++ b/src/egl/drivers/dri2/platform_surfaceless_metal.h
@@ -0,0 +1,18 @@
+/*
+ * Copyright 2026 The Playport authors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef PLATFORM_SURFACELESS_METAL_H
+#define PLATFORM_SURFACELESS_METAL_H
+
+/* The size in pixels of a window surface on a CAMetalLayer, the native window
+ * of the surfaceless platform on Apple systems: the layer's drawableSize, which
+ * the EGL client sets to the size it renders at (the layer scales the drawable
+ * to its bounds); before it has one, its bounds times its contents scale, the
+ * extent a Metal surface reports (wsi_metal_layer_size).
+ */
+void
+dri2_surfaceless_metal_layer_size(void *layer, int *width, int *height);
+
+#endif
diff --git a/src/egl/drivers/dri2/platform_surfaceless_metal.m b/src/egl/drivers/dri2/platform_surfaceless_metal.m
new file mode 100644
index 0000000..b87ab72
--- /dev/null
+++ b/src/egl/drivers/dri2/platform_surfaceless_metal.m
@@ -0,0 +1,26 @@
+/*
+ * Copyright 2026 The Playport authors
+ * SPDX-License-Identifier: MIT
+ */
+
+#import <QuartzCore/CAMetalLayer.h>
+
+#include "platform_surfaceless_metal.h"
+
+void
+dri2_surfaceless_metal_layer_size(void *layer, int *width, int *height)
+{
+   @autoreleasepool {
+      CAMetalLayer *metal_layer = (__bridge CAMetalLayer *)layer;
+      CGSize size = metal_layer.drawableSize;
+
+      if (size.width < 1 || size.height < 1) {
+         CGFloat scale = metal_layer.contentsScale;
+         size = metal_layer.bounds.size;
+         size.width *= scale;
+         size.height *= scale;
+      }
+      *width = size.width;
+      *height = size.height;
+   }
+}
