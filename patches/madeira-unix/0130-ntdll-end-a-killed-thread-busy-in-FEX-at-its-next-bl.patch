From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Mon, 12 Oct 2026 13:56:33 +0200
Subject: [PATCH] ntdll: end a killed thread busy in FEX at its next block

madeira-unix 0127 ends a killed thread by diverting it to
user_mode_abort_thread when the server finds it in code FEX translated
and holding nothing, and otherwise retries on a timer for about a minute.
A thread that rewrites code all the time is mostly in FEX itself
(translating, invalidating), so the childabort probe's terminate phase
still had 114 of 120 terminated i386 workers counting 500 ms after their
round; the abort had ended 29, after 2-642 tries.

When the thread is not at such a point, ios_abort_thread_in_guest_code
now marks it while it is suspended, as upstream's cooperative suspend
does (usr1_handler): it rings FEX's suspend doorbell in the thread's CPU
area and sets suspend_pending. The JIT checks the doorbell at the start
of each block, so the thread leaves simulation there, after it has let go
of FEX's locks, and continues with NtContinue; signal_set_full_context
then waits for the suspend in the server, where a killed thread ends.
It also sets a killed flag, which NtWaitForAlertByThreadId reads to end a
killed thread in an in-process wait, and wakes the thread's alert after
the resume (wine-unix 0033).

The writes go through mach_vm_write, so a thread that is gone cannot
fault the server. The doorbell lives in the thread's FEX state: FEX keeps
that state for a thread another one terminated (fex 0027, 0029), and
clears the CPU area (WoW64) or the doorbell pointer (ARM64EC) before it
frees the state of a thread that ends itself. signal_set_full_context
takes a pending suspend only with a CPU area and a doorbell pointer.

Class: upstream-bug
Evidence: docs/evidence/2026-10-12-killed-threads.md
Offered-upstream: no; signal delivery and the iOS abort are the iOS port's
---
 build/ntdll-unix/signal_arm64_ios.c | 64 +++++++++++++++++++++++++++--
 1 file changed, 60 insertions(+), 4 deletions(-)

diff --git a/build/ntdll-unix/signal_arm64_ios.c b/build/ntdll-unix/signal_arm64_ios.c
index 6f13f61..e495fcd 100644
--- a/build/ntdll-unix/signal_arm64_ios.c
+++ b/build/ntdll-unix/signal_arm64_ios.c
@@ -138,6 +138,7 @@ static int ios_sig_storm_gate( unsigned long *n )
 struct arm64_thread_data
 {
     BOOL suspend_pending;
+    BOOL killed;   /* Playport (PLA-222): set by ios_abort_thread_in_guest_code */
 };
 
 C_ASSERT( sizeof(struct arm64_thread_data) <= sizeof(((struct teb_data *)0)->cpu_data) );
@@ -6494,11 +6495,11 @@ NTSTATUS signal_set_full_context( CONTEXT *context )
 
     /* wine-11.18: a cooperative suspend requested by usr1_handler while the thread
      * was in simulation is taken here, before the new context is applied. */
-    if (arm64_data->suspend_pending && !cpu_area->InSyscallCallback && !cpu_area->InSimulation)
+    if (arm64_data->suspend_pending && cpu_area && !cpu_area->InSyscallCallback && !cpu_area->InSimulation)
     {
         sigset_t old_set;
         pthread_sigmask( SIG_BLOCK, &server_block_set, &old_set );
-        *cpu_area->SuspendDoorbell = 0;
+        if (cpu_area->SuspendDoorbell) *cpu_area->SuspendDoorbell = 0;
         arm64_data->suspend_pending = FALSE;
         wait_suspend( context );
         status = NtSetContextThread( GetCurrentThread(), context );
@@ -8242,6 +8243,51 @@ static BOOL abort_read( const void *addr, void *buf, size_t size )
                                    (mach_vm_address_t)buf, &got ) == KERN_SUCCESS && got == size;
 }
 
+/* Write memory of a thread that may be gone, without faulting. */
+static BOOL abort_write( void *addr, const void *buf, size_t size )
+{
+    return mach_vm_write( mach_task_self(), (mach_vm_address_t)addr, (vm_offset_t)buf,
+                          (mach_msg_type_number_t)size ) == KERN_SUCCESS;
+}
+
+/* Playport (PLA-222): whether the server killed the current thread; the
+ * in-process wait (NtWaitForAlertByThreadId) ends such a thread. */
+int ios_current_thread_killed( void )
+{
+    return arm64_thread_data( get_thread_data() )->killed;
+}
+
+/* Playport (PLA-222): mark a killed thread that is not at a point it can be
+ * diverted from, while it is suspended, so it ends at its next chance:
+ *  - killed: an in-process wait it is in or enters ends it (the caller wakes it
+ *    after the resume);
+ *  - FEX's suspend doorbell and suspend_pending, upstream's cooperative suspend
+ *    (usr1_handler): the JIT checks the doorbell at each block's start, raises
+ *    brk #0xCAFE, and FEX leaves simulation and continues with NtContinue, whose
+ *    signal_set_full_context then waits for the suspend in the server, where a
+ *    killed thread ends. A thread busy in FEX itself (translating, invalidating)
+ *    so ends at its next block, after it has let go of FEX's locks.
+ * The doorbell is a field of the thread's FEX state, which FEX keeps for a
+ * thread another one terminated (fex 0027, 0029) and whose pointer it clears
+ * before it frees the state of a thread that ends itself; the CPU area is read
+ * from the TEB, which WoW64 FEX clears first. A thread with no CPU area (no FEX)
+ * is only marked killed. Takes no lock and allocates nothing. */
+static void abort_mark_killed( TEB *teb )
+{
+    struct arm64_thread_data *arm64_data =
+        (struct arm64_thread_data *)((struct teb_data *)&teb->GdiTebBatch)->cpu_data;
+    CHPE_V2_CPU_AREA_INFO *cpu_area = NULL;
+    ULONG *doorbell = NULL;
+    const ULONG ring = ~0u;
+    const BOOL yes = TRUE;
+
+    if (!abort_write( &arm64_data->killed, &yes, sizeof(yes) )) return;
+    if (!abort_read( &teb->ChpeV2CpuAreaInfo, &cpu_area, sizeof(cpu_area) ) || !cpu_area) return;
+    if (!abort_read( &cpu_area->SuspendDoorbell, &doorbell, sizeof(doorbell) ) || !doorbell) return;
+    if (!abort_write( &arm64_data->suspend_pending, &yes, sizeof(yes) )) return;
+    abort_write( doorbell, &ring, sizeof(ring) );
+}
+
 
 /***********************************************************************
  *           ios_abort_thread_in_guest_code
@@ -8259,7 +8305,9 @@ static BOOL abort_read( const void *addr, void *buf, size_t size )
  * translated (the JIT pool outside every image copy), not in host code, a PE
  * module or FEX itself, and its TEB shows no FEX lock or syscall callback.
  * Anywhere else it is let go again and the server retries. Nothing between the
- * suspend and the resume takes a lock or allocates.
+ * suspend and the resume takes a lock or allocates. Such a thread is first
+ * marked (abort_mark_killed) so it ends at its next block or in-process wait
+ * (PLA-222), and its thread-id alert is woken.
  *
  * Returns 1 when the thread was diverted, 0 when it is not at such a point now,
  * -1 when it is gone (or has no TEB or syscall frame to end it with).
@@ -8316,7 +8364,15 @@ int ios_abort_thread_in_guest_code( mach_port_t port, TEB *teb )
     return 1;
 
 not_now:
-    thread_resume( port );
+    {
+        extern void ios_wake_killed_thread_alert( HANDLE tid );
+        HANDLE tid = 0;
+
+        abort_mark_killed( teb );
+        thread_resume( port );
+        if (abort_read( &teb->ClientId.UniqueThread, &tid, sizeof(tid) ) && tid)
+            ios_wake_killed_thread_alert( tid );
+    }
     return 0;
 gone:
     thread_resume( port );
